# ═══════════════════════════════════════════════════════════════════
#  실습 설정
#
#  1. cp .env.example .env      (Windows: copy .env.example .env)
#  2. 아래 "직접 채우는 값" 을 채우세요
#  3. python deploy_lab.py      나머지는 자동으로 채워집니다 (25~35분)
# ═══════════════════════════════════════════════════════════════════

# ── 직접 채우는 값 ────────────────────────────────────────────────

# 소문자/숫자/하이픈 2~20자
STUDENT_NAME=steve

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-northeast-2

# 진단 리포트를 받을 이메일. 비우면 SNS 구독을 만들지 않습니다.
# 채우면 배포 후 AWS 에서 구독 확인 메일이 오니 클릭해주세요.
ALERT_EMAIL=

# 클러스터에 올릴 Git 서버.
#   gitea  = 1분이면 뜹니다. 강의는 이걸로 진행합니다.
#   gitlab = 진짜 GitLab CE. 20~30분 걸리고 메모리를 많이 씁니다.
GIT_PROVIDER=gitea

# 콘솔이나 CloudShell 에서도 kubectl 을 쓰고 싶다면, 그 로그인 주체의 ARN.
# CloudShell 에서 아래로 확인한 값을 그대로 붙여넣으면 됩니다.
#     aws sts get-caller-identity --query Arn --output text
# 세션 ARN(arn:aws:sts::...:assumed-role/...)이어도 자동으로 변환됩니다.
# 값이 잘못돼도 배포는 계속 진행되고, 이 항목만 건너뜁니다.
# 비워두면 위 액세스 키 사용자만 클러스터에 접근할 수 있습니다.
# 나중에 추가하려면:  python grant_access.py <ARN>
EXTRA_ADMIN_ARN=

# 실습에 쓸 Bedrock 모델. check_env.py 가 사용 가능한 값을 알려줍니다.
BEDROCK_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0


# ── 여기부터는 deploy_lab.py 가 자동으로 씁니다. 손대지 마세요 ──
# --- 8< --- AUTO GENERATED BELOW --- 8< ---
